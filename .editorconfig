# Written by Kone Tshivhinda (Claude Opus 5.5) on 2026-09-25 — Shared editor settings across the language charter (P0)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_size = 4

[*.{java,kt,kts,gradle}]
indent_size = 4

[*.rs]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[justfile]
indent_size = 4

[*.sql]
indent_size = 4

[Dockerfile*]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
