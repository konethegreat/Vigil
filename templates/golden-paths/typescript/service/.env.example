# Written by Kone Tshivhinda (Qoder) on 2026-11-01 — Non-secret configuration shape for the TypeScript service golden path (P1 task 1.4)
#
# Copy to .env for local development only. .env files are never committed.
# Secret values never appear here: the token setting is a KMS reference.
VIGIL_SERVICE_NAME=vigil-service-template
VIGIL_ENVIRONMENT=dev
# Loopback default. Set to 0.0.0.0 only when a container network must reach the port.
VIGIL_HOST=127.0.0.1
VIGIL_PORT=8080
VIGIL_LOG_LEVEL=INFO
VIGIL_WARDEN_URL=http://warden:8080
VIGIL_INTERNAL_TOKEN_REF=kms://vigil/dev/service-auth#1

# Leave empty to disable OTLP export (the default, no required egress).
# VIGIL_OTEL_ENDPOINT wins over OTEL_EXPORTER_OTLP_ENDPOINT when both are set.
OTEL_EXPORTER_OTLP_ENDPOINT=
