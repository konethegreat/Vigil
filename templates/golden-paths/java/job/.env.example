# Written by Kone Tshivhinda (Qoder) on 2026-11-01 — Non-secret configuration shape for the Java job golden path (P1 task 1.4)
#
# Pass these as environment variables when the scheduler invokes the job.
# Secret values never appear here: the token setting is a KMS reference.
VIGIL_TENANT_ID=tenant-1
VIGIL_PURPOSE=DATA_INTEGRATION
VIGIL_WARDEN_URL=http://warden:8080
VIGIL_POLICY_TOKEN_REF=kms://vigil/dev/job-token#1
VIGIL_BATCH_SIZE=100

# Leave empty to disable OTLP export (the default, no required egress).
VIGIL_OTEL_ENDPOINT=
