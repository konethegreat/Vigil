# Written by Kone Tshivhinda (Qoder) on 2026-11-01 — Non-secret configuration shape for the Java service golden path (P1 task 1.4)
#
# Spring Boot reads environment variables, not this file. Copy the shape into
# your shell, Compose environment or the deployment's secret manager entries.
# Secret values never appear here: the token setting is a KMS reference.
VIGIL_SERVICE_NAME=vigil-service-template
VIGIL_ENVIRONMENT=dev
VIGIL_PORT=8000
VIGIL_WARDEN_URL=http://warden:8080
VIGIL_INTERNAL_TOKEN_REF=kms://vigil/dev/service-auth#1

# Leave empty to disable OTLP export (the default, no required egress).
VIGIL_OTEL_ENDPOINT=
